{
  "name": "chivomed-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Entorno de desarrollo del frontend de ChivoMed",
  "author": "Julio Ernesto Calderon Umana",
  "scripts": {
    "start": "node scripts/dev_server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integracion/*.test.js",
    "cobertura": "node --test --experimental-test-coverage --test-coverage-include=src/** tests/*.test.js tests/integracion/*.test.js"
  },
  "engines": {
    "node": ">=22.5"
  }
}
